faf_version: "3.3"
project:
  name: rust-faf-mcp
  goal: Rust MCP server for FAF (Foundational AI-context Format) — IANA-registered application/vnd.faf+yaml
  main_language: Rust
  version: 0.2.2
  license: MIT
instant_context:
  what_building: Rust MCP server — 8 tools (faf_init, faf_git, faf_read, faf_score, faf_sync, faf_compress, faf_discover, faf_tokens) powered by rmcp SDK + faf-rust-sdk
  tech_stack: Rust 2021, rmcp 1.1, faf-rust-sdk 1.3, serde, reqwest, tokio
  key_files:
    - Cargo.toml
    - src/main.rs
    - src/server.rs
    - src/tools.rs
    - README.md
    - LICENSE
  commands:
    build: cargo build
    test: cargo test
    lint: cargo clippy -- -D warnings
    fmt: cargo fmt --check
    publish: cargo publish
stack:
  backend: Rust
  build_tool: cargo
  testing: cargo test (91 tests, WJTTC 4-tier)
  registry: crates.io
human_context:
  who: wolfejam
  what: Rust-native MCP server for FAF format
  why: First downstream consumer of faf-rust-sdk, completing the Rust FAF ecosystem
  how: rmcp SDK stdio transport, one binary, zero config
tags:
  - faf
  - mcp
  - rust
  - ai-context
  - model-context-protocol
state:
  phase: production
  version: 0.2.2
metadata:
  last_claude_sync: 2026-03-06T07:51:38.701Z
  bi_sync: active
